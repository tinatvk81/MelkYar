# این فایل را کپی کنید به .env و مقادیر واقعی را داخلش بگذارید.
# .env هرگز نباید commit یا برای کسی فرستاده شود.

# با این دستور یک کلید امن بسازید:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE-ME-WITH-A-RANDOM-GENERATED-SECRET

# در سرور واقعی حتماً False
DEBUG=False

# دامنه‌های واقعی، با کاما جدا (بدون فاصله اضافه)
ALLOWED_HOSTS=melkyar.example.com,www.melkyar.example.com

# دامنه‌ی فرانت‌اندی که اجازه دارد به این API درخواست بزند
CORS_ALLOWED_ORIGINS=https://app.melkyar.example.com

# --- دیتابیس ---
# برای توسعه محلی این خط را کامنت بگذارید تا SQLite استفاده شود.
# برای production حتماً پستگرس:
DB_ENGINE=postgresql
DB_NAME=melkyar
DB_USER=melkyar_user
DB_PASSWORD=REPLACE-ME-WITH-A-STRONG-DB-PASSWORD
DB_HOST=localhost
DB_PORT=5432
